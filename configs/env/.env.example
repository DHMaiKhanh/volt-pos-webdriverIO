# ─────────────────────────────────────────────────────────────────────────────
# Volt POS E2E — environment template
#
# Copy to `.env.dev`, `.env.staging`, `.env.prod` and fill in the secrets.
# Those three files are git-ignored; THIS file is tracked and must never hold a
# real credential.
#
# Precedence: real process env  >  .env.<ENV>  >  .env.local  >  .env.example
# ─────────────────────────────────────────────────────────────────────────────

# ── Which build is under test ────────────────────────────────────────────────
# dev | staging | prod. Chosen by the npm script (`cross-env ENV=…`), not here.
#
# IMPORTANT: this does NOT repoint a running app at another backend. The app
# bakes UPSTREAM_BASE_URI in at COMPILE time (src-tauri/build.rs -> env!()), so
# each environment is a DIFFERENT .exe. ENV selects which one to drive.
# ENV=dev

# Absolute path to the executable. Leave blank to auto-discover
# (%LOCALAPPDATA%\volt-pos\volt-pos-app.exe, then Program Files, then a debug
# build under VOLT_POS_SRC). CI must always set this explicitly.
APP_PATH=

# Extra CLI args handed to the app process, comma separated.
APP_ARGS=

# %APPDATA% folder name. `VoltPOS` comes from src-tauri/tauri.windows.conf.json,
# which overrides the base identifier `com.fastboy.volt-pos`.
APP_IDENTIFIER=VoltPOS

# Checkout of the app repo. Enables the debug-build fallback and
# `npm run audit:testids`.
VOLT_POS_SRC=D:/2.POS/volt-pos/volt-pos

# ── Account under test ───────────────────────────────────────────────────────
MERCHANT_ID=14
# The ONLY typed credential this app has. /login is a QR login and cannot be
# automated; the staff-token form at /login-staff-token is the fallback, reached
# by the secret tap on the version line. Usually unused - a device stays signed
# in between runs - so leaving this empty is fine until one gets signed out.
STAFF_TOKEN=
# Owner-level passcode: settings, reports, refunds.
OWNER_PASSCODE=8888
# Staff passcode used by payment flows. The staff MUST hold `completed_payment`.
STAFF_PASSCODE=9999
STAFF_NAME=

# Customer whose loyalty points the Checkout Type specs (VP-4591) measure.
# Digits only; must be a customer of MERCHANT_ID. Empty -> those specs skip.
LOYALTY_CUSTOMER_PHONE=

# ── GoPOS WEB lane (create an appointment from the browser, then verify sync) ──
# The web POS used by `npm run web:appointment`. Login is two steps:
# WEB_MERCHANT_ID -> Log In -> WEB_USERNAME + WEB_PASSWORD -> Log In.
WEB_URL=https://pos.gocheckin.net/login
WEB_MERCHANT_ID=14
WEB_USERNAME=
WEB_PASSWORD=
# The appointment the lane books. Customer fields are PII — fill them only in the
# git-ignored .env.dev, never here. Staff / service are the store's own labels.
WEB_CUSTOMER_PHONE=
WEB_CUSTOMER_NAME=
WEB_STAFF=
WEB_SERVICE=

# ── GoCheckin KIOSK lane (create a check-in on gap.gocheckin.net, verify sync) ─
# Used by `npm run web:checkin`. Owner login reuses WEB_MERCHANT_ID /
# WEB_USERNAME / WEB_PASSWORD above (same tenant). The kiosk mints a fresh
# customer each run, so no PII lives here.
GAP_URL=https://gap.gocheckin.net/home

# ── Safety rails ─────────────────────────────────────────────────────────────
# Allow specs to CREATE data. Ignored for ENV=prod, which additionally requires
# ALLOW_PROD_WRITES=i-know-what-i-am-doing.
WRITE_ALLOWED=true

# Wipe %APPDATA%\VoltPOS\Databases\<MERCHANT_ID> before the session so the run
# starts from a known state. Always forced off for prod.
RESET_DB=false

# Auto-dismiss the software-updater toast / forced-update screen.
# It cannot be blocked at the source (the endpoint is baked into the binary and
# the check runs from Rust), and the app's comparator is `|_current, _update| true`
# so it treats EVERY response as newer. The toast lands top-right, over real
# controls — leaving this on is not optional in practice.
AUTO_DISMISS_UPDATER=true

# ── Drivers ──────────────────────────────────────────────────────────────────
DRIVER_HOST=127.0.0.1
DRIVER_PORT=4444
# Leave blank to use the copies installed by `npm run setup:drivers`.
TAURI_DRIVER_PATH=
MSEDGEDRIVER_PATH=
# WebView2 CDP port used by `attach` mode (npm run app:launch).
REMOTE_DEBUG_PORT=9222

# ── Run behaviour ────────────────────────────────────────────────────────────
LOG_LEVEL=info
SPEC_RETRIES=1
SHOW_STEPS=true
KEEP_APP_OPEN=false
